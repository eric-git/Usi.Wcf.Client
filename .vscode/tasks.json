{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Usi.Wcf.Client.slnx",
        "--nologo",
        "/graph",
        "/m"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/src/Usi.Wcf.Client.slnx",
        "--nologo",
        "/graph",
        "/m"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/src/Usi.Wcf.Client.slnx"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
